  "standard_domain_events": ["member.registered", "member.logged_in", "order.created", "order.status_changed", "order.paid", "order.refunded", "payment.completed", "payment.failed", "points.changed", "notification.sent"],
  "core_slots": ["site.head", "site.body_start", "site.content.before", "site.content.after", "site.footer", "admin.navigation", "admin.dashboard", "admin.product.sidebar", "admin.product.list_actions", "admin.product.bulk_actions", "admin.product.row_actions", "admin.post.sidebar", "admin.post.list_actions", "admin.post.row_actions"],
  "single_services": ["member.identity", "order.manager", "points.manager", "cart.manager"],
