#!/usr/bin/env php
<?php
declare(strict_types=1);

define('APP_ENTRY_POINT', true);
define('APP_ROOT', str_replace('\\', '/', __DIR__));
define('APP_BASE_PATH', '');
define('APP_VERSION', '1.3.0');
define('APP_DEBUG', true);

spl_autoload_register(static function (string $class): void {
    $prefix = 'App\\';
    if (!str_starts_with($class, $prefix)) return;
    $file = APP_ROOT . '/app/' . str_replace('\\', '/', substr($class, strlen($prefix))) . '.php';
    if (is_file($file)) require $file;
});
require APP_ROOT . '/app/Helpers/Helpers.php';

use App\Plugins\Jobs\JobRunner;
use App\Plugins\PluginManager;

$args = $argv;
array_shift($args);
$command = array_shift($args) ?? 'help';
if ($command === 'plugin') $command = 'plugin:' . (array_shift($args) ?? 'help');

try {
    switch ($command) {
        case 'plugin:make':
            $id = sanitize_slug_input((string)($args[0] ?? ''));
            if ($id === '') throw new RuntimeException('用法：php shopagg plugin:make <plugin-id>');
            $directory = APP_ROOT . '/plugin-dev/' . $id;
            if (file_exists($directory)) throw new RuntimeException("目录已存在：{$directory}");
            mkdir($directory . '/src', 0755, true);
            $class = str_replace(' ', '', ucwords(str_replace('-', ' ', $id)));
            $manifest = [
                'schema_version' => 1, 'id' => $id, 'name' => $class, 'vendor' => 'Custom', 'version' => '1.0.0',
                'description' => 'ShopAgg custom plugin', 'requires' => ['shopagg' => '>=1.3.0', 'php' => '>=8.1.0'],
                'autoload' => ['psr4' => ["Custom\\{$class}\\" => 'src/']], 'lifecycle' => "Custom\\{$class}\\Plugin",
                'routes' => [], 'events' => [], 'filters' => [], 'slots' => [], 'services' => [], 'jobs' => [],
                'admin_menu' => [], 'permissions' => [], 'settings' => [], 'dependencies' => [], 'conflicts' => [], 'assets' => [],
            ];
            file_put_contents($directory . '/plugin.json', json_encode($manifest, JSON_PRETTY_PRINT | JSON_UNESCAPED_UNICODE | JSON_UNESCAPED_SLASHES) . "\n");
            $code = "<?php\ndeclare(strict_types=1);\nnamespace Custom\\{$class};\nuse App\\Plugins\\Contracts\\PluginInterface;\nuse App\\Plugins\\PluginContext;\nfinal class Plugin implements PluginInterface {\n    public function activate(PluginContext \$context): void {}\n    public function deactivate(PluginContext \$context): void {}\n    public function uninstall(PluginContext \$context): void {}\n}\n";
            file_put_contents($directory . '/src/Plugin.php', $code);
            file_put_contents($directory . '/README.md', "# {$class}\n\nGenerated by ShopAgg Plugin SDK.\n");
            echo "Created: {$directory}\n";
            break;

        case 'plugin:validate':
        case 'plugin:test':
            $path = realpath((string)($args[0] ?? ''));
            if ($path === false || !is_dir($path)) throw new RuntimeException('请提供插件目录路径');
            $result = (new PluginManager())->validateDirectory($path);
            echo json_encode($result, JSON_PRETTY_PRINT | JSON_UNESCAPED_UNICODE | JSON_UNESCAPED_SLASHES) . "\n";
            exit($result['valid'] ? 0 : 1);

        case 'plugin:pack':
            $path = realpath((string)($args[0] ?? ''));
            if ($path === false || !is_dir($path)) throw new RuntimeException('请提供插件目录路径');
            $validation = (new PluginManager())->validateDirectory($path);
            if (!$validation['valid']) throw new RuntimeException(implode('; ', array_column($validation['errors'], 'message')));
            $target = $args[1] ?? (dirname($path) . '/' . basename($path) . '-' . $validation['manifest']['version'] . '.zip');
            $zip = new ZipArchive();
            if ($zip->open($target, ZipArchive::CREATE | ZipArchive::OVERWRITE) !== true) throw new RuntimeException('无法创建 ZIP');
            $iterator = new RecursiveIteratorIterator(new RecursiveDirectoryIterator($path, FilesystemIterator::SKIP_DOTS));
            foreach ($iterator as $file) {
                if ($file->isLink() || !$file->isFile()) continue;
                $zip->addFile($file->getPathname(), basename($path) . '/' . $iterator->getSubPathName());
            }
            $zip->close();
            echo "Packed: {$target}\n";
            break;

        case 'plugin:install':
            $path = realpath((string)($args[0] ?? ''));
            if ($path === false || !is_file($path)) throw new RuntimeException('请提供插件 ZIP 路径');
            $result = (new PluginManager())->installZip($path, 'cli');
            echo json_encode($result, JSON_PRETTY_PRINT | JSON_UNESCAPED_UNICODE) . "\n";
            break;

        case 'plugin:enable':
            (new PluginManager())->enable((string)($args[0] ?? ''));
            echo "Plugin enabled\n";
            break;

        case 'plugin:disable':
            (new PluginManager())->disable((string)($args[0] ?? ''));
            echo "Plugin disabled\n";
            break;

        case 'plugin:rollback':
            (new PluginManager())->rollback((string)($args[0] ?? ''), isset($args[1]) ? (string)$args[1] : null);
            echo "Plugin version switched\n";
            break;

        case 'plugin:jobs':
            $limit = max(1, min(100, (int)($args[0] ?? 10)));
            echo json_encode((new JobRunner())->runDue($limit), JSON_PRETTY_PRINT | JSON_UNESCAPED_UNICODE) . "\n";
            break;

        case 'help':
        case 'plugin:help':
            echo "ShopAgg Plugin CLI\n\n";
            echo "  php shopagg plugin:make <id>\n";
            echo "  php shopagg plugin:validate <directory>\n";
            echo "  php shopagg plugin:test <directory>\n";
            echo "  php shopagg plugin:pack <directory> [target.zip]\n";
            echo "  php shopagg plugin:install <plugin.zip>\n";
            echo "  php shopagg plugin:enable <plugin-id>\n";
            echo "  php shopagg plugin:disable <plugin-id>\n";
            echo "  php shopagg plugin:rollback <plugin-id> [version]\n";
            echo "  php shopagg plugin:jobs [limit]\n";
            break;

        default:
            throw new RuntimeException("未知命令：{$command}");
    }
} catch (Throwable $e) {
    fwrite(STDERR, "Error: {$e->getMessage()}\n");
    exit(1);
}
